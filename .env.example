# Postgres on Neon. Use the `dev` branch URL for development and tests,
# the `main` branch URL in production. Never point tests at `main`.
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/sliderule?sslmode=require

# Clerk (auth; org id and role are read from the JWT)
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# From the Clerk dashboard -> API keys -> JWKS URL, e.g.
# https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=

# Anthropic (model calls go through the injectable ModelClient)
ANTHROPIC_API_KEY=sk-ant-xxx
