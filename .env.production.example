# Production environment. Copy to .env.production on the prod host only.
# NEVER point this at the Neon dev or ci branches.

# Neon `production` branch URL
DATABASE_URL=

# Clerk PRODUCTION instance (requires a domain; until one exists the
# development instance keys work with strict usage limits)
CLERK_JWKS_URL=

# Public domain for the API (DuckDNS subdomain pointed at this host).
# Caddy obtains the TLS certificate for it automatically.
SLIDERULE_DOMAIN=sliderule.duckdns.org

# Web app origin allowed to call the API (comma-separated)
SLIDERULE_WEB_ORIGINS=https://sliderule-web.vercel.app

ANTHROPIC_API_KEY=

# Email finder + verifier — used only by the worker, after a human approved
# the person. Hunter Free: 50 searches + 100 verifications / month. Budget 2
# = one search + one verification per approved person.
HUNTER_API_KEY=
SLIDERULE_EMAIL_FINDER=hunter
SLIDERULE_FIND_CONTACT_BUDGET=2
SLIDERULE_FIND_CONTACT_MAX_STEPS=8
